{
  "name": "Dimension-Workshop",
  "version": "1.0.0",
  "type": "module",
  "description": "Mod Management · Automation Tools · Game Solutions",
  "main": "./out/main/index.js",
  "author": "skrmaster",
  "license": "MIT",
  "homepage": "https://github.com/skrmaster/dimension-workshop",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/roboto": "^5.2.10",
    "@tailwindcss/vite": "^4.3.0",
    "@vueuse/core": "^14.3.0",
    "7zip-bin": "^5.2.0",
    "better-sqlite3": "^12.10.0",
    "dayjs": "^1.11.21",
    "electron-localshortcut": "^3.2.1",
    "electron-store": "^11.0.2",
    "gsap": "^3.15.0",
    "md-editor-v3": "^6.5.1",
    "node-7z": "^3.0.0",
    "pinia": "^3.0.4",
    "splitpanes": "^4.1.2",
    "tailwindcss": "^4.3.0",
    "trash": "^10.1.1",
    "vue-i18n": "^9.4.0",
    "vue-router": "^5.0.7",
    "vuetify": "^4.0.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@mdi/font": "^7.4.47",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-localshortcut": "^3.1.3",
    "@types/node": "^22.19.1",
    "@types/node-7z": "^2.1.11",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "unplugin-fonts": "^2.0.0",
    "vite": "^7.2.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  }
}
