{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.d.ts",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts",
    "src/shared/env.d.ts",
    "src/shared/**/*",
    "src/shared/**/*.vue",
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": "./",
    "paths": {
      "@renderer/*": [ "src/renderer/src/*" ],
      "@shared/*": [ "src/shared/*" ],
      "#types/*": [ "src/renderer/src/types/*" ]
    }
  }
}
